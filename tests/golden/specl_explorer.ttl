spec:DN1 a specl:DesignNote ;
    specl:partOf <https://w3id.org/specl/explorer/spec> ;
    dct:title "The Turtle parser does not need to be RFC-compliant" ;
    dct:description "The Turtle parser does not need to be RFC-compliant. It only needs to handle the output of `specl.spec_to_rdf`, which is deterministic and well-formed. A 30-line parser is sufficient." ;
    prov:wasDerivedFrom spec:source-e9e453bf ;
    specl:sourceLine "103"^^xsd:integer .

spec:DN2 a specl:DesignNote ;
    specl:partOf <https://w3id.org/specl/explorer/spec> ;
    dct:title "Prefer declarative CSS over runtime style manipulation" ;
    dct:description "Prefer declarative CSS over runtime style manipulation. Use CSS classes and variables; avoid setting styles via JavaScript except for the maturity bar width and color." ;
    prov:wasDerivedFrom spec:source-e9e453bf ;
    specl:sourceLine "104"^^xsd:integer .

spec:DN3 a specl:DesignNote ;
    specl:partOf <https://w3id.org/specl/explorer/spec> ;
    dct:title "Keep the JavaScript in a single `<script>` block at the bottom of the file" ;
    dct:description "Keep the JavaScript in a single `<script>` block at the bottom of the file. No modules, no imports, no bundler." ;
    prov:wasDerivedFrom spec:source-e9e453bf ;
    specl:sourceLine "105"^^xsd:integer .

spec:DN4 a specl:DesignNote ;
    specl:partOf <https://w3id.org/specl/explorer/spec> ;
    dct:title "Treat the explorer as read-only" ;
    dct:description "Treat the explorer as read-only. Editing, saving, or uploading is explicitly out of scope for v1." ;
    prov:wasDerivedFrom spec:source-e9e453bf ;
    specl:sourceLine "106"^^xsd:integer .

