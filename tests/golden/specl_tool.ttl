@prefix specl: <https://w3id.org/specl/ns#> .
@prefix spec: <https://w3id.org/specl/tool/spec#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://w3id.org/specl/tool/spec> a specl:Specification ;
    dct:conformsTo <https://w3id.org/specl/contract/2> ;
    dct:title "SPECL Tool" ;
    dct:hasVersion "1.0.0" ;
    specl:status "review" ;
    dct:identifier "specl-tool-001" ;
    specl:prefix "TOOL" ;
    dct:created "2026-08-19"^^xsd:date ;
    specl:intent """Specify the SPECL toolchain itself — the parser, validator, scorer, badge generator, LLM assistant, and explorer — so the tool is governed by the same spec-driven process it provides to downstream projects.""" ;
    specl:purpose """Give SPECL a maturity signal of its own. Every capability the tool exposes to consumers must be traceable to a requirement with acceptance criteria, a priority, and a verification artifact.""" .

spec:source-e9e453bf a specl:SourceDocument ;
    dct:identifier "spec.md" .

spec:R1.1 a specl:Requirement ;
    specl:partOf <https://w3id.org/specl/tool/spec> ;
    dct:title "`specl-translate` must parse markdown with YAML front-matter, H1 sections…" ;
    dct:description "`specl-translate` must parse markdown with YAML front-matter, H1 sections, ID-bulleted items (R, US, OQ, D prefixes), and indented sub-bullet annotations into valid Turtle." ;
    prov:wasDerivedFrom spec:source-e9e453bf ;
    specl:sourceLine "23"^^xsd:integer ;
    specl:implementationStatus "verified" ;
    specl:priority "MUST" ;
    specl:constrains spec:component-spec_to_rdf ;
    specl:acceptanceCriterion "Given any markdown spec conforming to docs/SYNTAX.md, when translated, the output parses without error in rdflib and every ID-bulleted item appears as a typed individual with specl:partOf linking to the spec." ;
    specl:verifiedBy spec:test-2ac14e7b .

spec:R1.2 a specl:Requirement ;
    specl:partOf <https://w3id.org/specl/tool/spec> ;
    dct:title "Sub-bullet annotations must populate structured RDF properties (priority…" ;
    dct:description "Sub-bullet annotations must populate structured RDF properties (priority, acceptance, verifiedBy, constrains, role, capability, benefit, owner, recommendation, decisionStatus, resolutionStatus, rationale, affects)." ;
    prov:wasDerivedFrom spec:source-e9e453bf ;
    specl:sourceLine "29"^^xsd:integer ;
    specl:implementationStatus "verified" ;
    specl:priority "MUST" ;
    specl:constrains spec:component-spec_to_rdf ;
    specl:acceptanceCriterion "Given a requirement with all annotation keys, when translated, the output contains the corresponding specl: triples with correct property names." ;
    specl:verifiedBy spec:test-1d8c4efd .

spec:R1.3 a specl:Requirement ;
    specl:partOf <https://w3id.org/specl/tool/spec> ;
    dct:title "Comma-separated values on constrains and affects sub-bullets must produce…" ;
    dct:description "Comma-separated values on constrains and affects sub-bullets must produce multiple triples. Prose keys must not split on commas." ;
    prov:wasDerivedFrom spec:source-e9e453bf ;
    specl:sourceLine "35"^^xsd:integer ;
    specl:implementationStatus "verified" ;
    specl:priority "MUST" ;
    specl:constrains spec:component-spec_to_rdf ;
    specl:acceptanceCriterion "Given `constrains: A, B`, output has two specl:constrains triples. Given `acceptance: Given X, when Y`, output has one specl:acceptanceCriterion triple with the full comma-containing string." ;
    specl:verifiedBy spec:test-f4605846 .

spec:R1.4 a specl:Requirement ;
    specl:partOf <https://w3id.org/specl/tool/spec> ;
    dct:title "Specs without sub-bullet annotations must produce identical output to specl…" ;
    dct:description "Specs without sub-bullet annotations must produce identical output to specl 0.1.x." ;
    prov:wasDerivedFrom spec:source-e9e453bf ;
    specl:sourceLine "41"^^xsd:integer ;
    specl:implementationStatus "implemented" ;
    specl:priority "MUST" ;
    specl:constrains spec:component-spec_to_rdf ;
    specl:acceptanceCriterion "Given the EKGA reference spec with no sub-bullets, the translated subject set is identical to the 0.1.x golden file." .

spec:R1.5 a specl:Requirement ;
    specl:partOf <https://w3id.org/specl/tool/spec> ;
    dct:title "The `--strict` flag must print parser warnings to stderr without failing the…" ;
    dct:description "The `--strict` flag must print parser warnings to stderr without failing the translation. Retained for compatibility; it selects behavior that R1.6 makes unconditional." ;
    prov:wasDerivedFrom spec:source-e9e453bf ;
    specl:sourceLine "46"^^xsd:integer ;
    specl:implementationStatus "verified" ;
    specl:priority "SHOULD" ;
    specl:constrains spec:component-spec_to_rdf ;
    specl:acceptanceCriterion "Given a spec with an unrecognized annotation key, when translated with --strict, stderr contains a warning and the exit code is 0." ;
    specl:verifiedBy spec:test-c29032e5 .

spec:R1.6 a specl:Requirement ;
    specl:partOf <https://w3id.org/specl/tool/spec> ;
    dct:title "Parser warnings must print to stderr on every translation, with no flag…" ;
    dct:description "Parser warnings must print to stderr on every translation, with no flag required, followed by a count naming the source file. A warning that appears only behind a flag is one nobody reads." ;
    prov:wasDerivedFrom spec:source-e9e453bf ;
    specl:sourceLine "52"^^xsd:integer ;
    specl:implementationStatus "verified" ;
    specl:priority "MUST" ;
    specl:constrains spec:component-spec_to_rdf ;
    specl:acceptanceCriterion "Given a spec with an unrecognized annotation key, when translated with no flags, stderr contains the warning and a count line." ;
    specl:verifiedBy spec:test-8213dfec .

spec:R1.8 a specl:Requirement ;
    specl:partOf <https://w3id.org/specl/tool/spec> ;
    dct:title "An indented bullet that names no known annotation key must be read as nested…" ;
    dct:description "An indented bullet that names no known annotation key must be read as nested content when it sits at four or more columns, and must warn as a probable typo below that. Nested lines attach to the item as an `rdf:List` on `specl:detail` in source order, with IRI-named cells rather than blank nodes." ;
    prov:wasDerivedFrom spec:source-e9e453bf ;
    specl:sourceLine "58"^^xsd:integer ;
    specl:implementationStatus "verified" ;
    specl:priority "MUST" ;
    specl:constrains spec:component-spec_to_rdf ;
    specl:acceptanceCriterion "Given a requirement with a four-column sub-list of unrecognized keys, translation emits an rdf:List on specl:detail containing those lines in order, every node in the graph is an IRI, and no warning is produced. Given the same lines at two columns, translation warns." ;
    specl:verifiedBy spec:test-bc148b61 .

spec:R1.7 a specl:Requirement ;
    specl:partOf <https://w3id.org/specl/tool/spec> ;
    dct:title "The `--fail-on-warning` flag must exit non-zero when the parser produced any…" ;
    dct:description "The `--fail-on-warning` flag must exit non-zero when the parser produced any warning, after writing the output file. The output is written either way, because reading the emitted graph is how the cost of a dropped line is seen." ;
    prov:wasDerivedFrom spec:source-e9e453bf ;
    specl:sourceLine "64"^^xsd:integer ;
    specl:implementationStatus "verified" ;
    specl:priority "MUST" ;
    specl:constrains spec:component-spec_to_rdf ;
    specl:acceptanceCriterion "Given a spec with an unrecognized annotation key, when translated with --fail-on-warning, the output file exists and the exit code is 1. Given a spec with no warnings, the exit code is 0." ;
    specl:verifiedBy spec:test-db5f33a3 .

spec:R2.1 a specl:Requirement ;
    specl:partOf <https://w3id.org/specl/tool/spec> ;
    dct:title "`specl-validate validate` must run the SHACL shapes graph against a translated…" ;
    dct:description "`specl-validate validate` must run the SHACL shapes graph against a translated spec and report violations and warnings." ;
    prov:wasDerivedFrom spec:source-e9e453bf ;
    specl:sourceLine "72"^^xsd:integer ;
    specl:implementationStatus "verified" ;
    specl:priority "MUST" ;
    specl:constrains spec:component-validate_spec ;
    specl:acceptanceCriterion "Given a spec.ttl with a missing dct:description on a Requirement, validation reports a Violation." ;
    specl:verifiedBy spec:test-9b0013ce .

spec:R2.2 a specl:Requirement ;
    specl:partOf <https://w3id.org/specl/tool/spec> ;
    dct:title "The severity gate must be driven by the spec's own specl:status value" ;
    dct:description "The severity gate must be driven by the spec's own specl:status value." ;
    prov:wasDerivedFrom spec:source-e9e453bf ;
    specl:sourceLine "78"^^xsd:integer ;
    specl:implementationStatus "verified" ;
    specl:priority "MUST" ;
    specl:constrains spec:component-validate_spec ;
    specl:acceptanceCriterion "Given a spec at status draft with Warnings only, validate exits 0. Given status production with Warnings, validate exits 1." ;
    specl:verifiedBy spec:test-66125139 .

spec:R2.3 a specl:Requirement ;
    specl:partOf <https://w3id.org/specl/tool/spec> ;
    dct:title "`specl-validate score` must report a maturity percentage based on…" ;
    dct:description "`specl-validate score` must report a maturity percentage based on production-ready requirements." ;
    prov:wasDerivedFrom spec:source-e9e453bf ;
    specl:sourceLine "84"^^xsd:integer ;
    specl:implementationStatus "verified" ;
    specl:priority "MUST" ;
    specl:constrains spec:component-validate_spec ;
    specl:acceptanceCriterion "Given 3 of 10 requirements with all four production properties, score reports 30%." ;
    specl:verifiedBy spec:test-bd84d84c .

spec:R2.4 a specl:Requirement ;
    specl:partOf <https://w3id.org/specl/tool/spec> ;
    dct:title "`specl-validate badge` must produce a valid SVG file with color reflecting the…" ;
    dct:description "`specl-validate badge` must produce a valid SVG file with color reflecting the maturity score." ;
    prov:wasDerivedFrom spec:source-e9e453bf ;
    specl:sourceLine "90"^^xsd:integer ;
    specl:implementationStatus "verified" ;
    specl:verifiedBy spec:test-63bb3a4e ;
    specl:priority "SHOULD" ;
    specl:constrains spec:component-validate_spec ;
    specl:acceptanceCriterion "Given a score of 40%, the badge SVG contains fill color matching the red threshold." .

spec:R2.5 a specl:Requirement ;
    specl:partOf <https://w3id.org/specl/tool/spec> ;
    dct:title "`specl-validate diff` must report added, removed, and modified requirements…" ;
    dct:description "`specl-validate diff` must report added, removed, and modified requirements between two Turtle files." ;
    prov:wasDerivedFrom spec:source-e9e453bf ;
    specl:sourceLine "96"^^xsd:integer ;
    specl:implementationStatus "verified" ;
    specl:priority "SHOULD" ;
    specl:constrains spec:component-validate_spec ;
    specl:acceptanceCriterion "Given old.ttl with R1.1 and new.ttl with R1.1 (changed) and R1.2 (added), diff reports 1 added and 1 modified." ;
    specl:verifiedBy spec:test-8521bcd5 .

spec:R3.1 a specl:Requirement ;
    specl:partOf <https://w3id.org/specl/tool/spec> ;
    dct:title "All generated Turtle must use `https://w3id.org/specl/ns#` as the vocabulary…" ;
    dct:description "All generated Turtle must use `https://w3id.org/specl/ns#` as the vocabulary namespace and the specification's own declared `spec_base` as the instance namespace. The translator must never mint instance IRIs into a namespace the specification did not declare." ;
    prov:wasDerivedFrom spec:source-e9e453bf ;
    specl:sourceLine "104"^^xsd:integer ;
    specl:implementationStatus "verified" ;
    specl:priority "MUST" ;
    specl:constrains spec:component-spec_to_rdf ;
    specl:constrains spec:component-core_ttl ;
    specl:acceptanceCriterion "Given any spec, translated output prefixes are specl: and spec: pointing to the w3id.org URIs." ;
    specl:verifiedBy spec:test-2d1c2438 .

spec:R4.1 a specl:Requirement ;
    specl:partOf <https://w3id.org/specl/tool/spec> ;
    dct:title "The explorer must be a single self-contained HTML file under 30 KB" ;
    dct:description "The explorer must be a single self-contained HTML file under 30 KB." ;
    prov:wasDerivedFrom spec:source-e9e453bf ;
    specl:sourceLine "112"^^xsd:integer ;
    specl:implementationStatus "verified" ;
    specl:verifiedBy spec:test-94401fb8 ;
    specl:priority "MUST" ;
    specl:constrains spec:component-explorer ;
    specl:acceptanceCriterion "explorer.html file size is under 30720 bytes and contains no external resource references." .

spec:R5.1 a specl:Requirement ;
    specl:partOf <https://w3id.org/specl/tool/spec> ;
    dct:title "`specl-assist gaps` must read SHACL warnings and draft remediation prompts via…" ;
    dct:description "`specl-assist gaps` must read SHACL warnings and draft remediation prompts via Ollama." ;
    prov:wasDerivedFrom spec:source-e9e453bf ;
    specl:sourceLine "120"^^xsd:integer ;
    specl:implementationStatus "in-progress" ;
    specl:priority "SHOULD" ;
    specl:constrains spec:component-spec_assistant ;
    specl:acceptanceCriterion "Given a spec with warnings and a running Ollama instance, gaps prints a draft for each warning." .

spec:R5.2 a specl:Requirement ;
    specl:partOf <https://w3id.org/specl/tool/spec> ;
    dct:title "`specl-assist check` must flag contradictions and duplications across…" ;
    dct:description "`specl-assist check` must flag contradictions and duplications across requirements." ;
    prov:wasDerivedFrom spec:source-e9e453bf ;
    specl:sourceLine "125"^^xsd:integer ;
    specl:implementationStatus "in-progress" ;
    specl:priority "SHOULD" ;
    specl:constrains spec:component-spec_assistant ;
    specl:acceptanceCriterion "Given a spec with two requirements that contradict, check output includes a finding referencing both." .

spec:R6.1 a specl:Requirement ;
    specl:partOf <https://w3id.org/specl/tool/spec> ;
    dct:title "The package must be installable via `pip install specl` and register three…" ;
    dct:description "The package must be installable via `pip install specl` and register three console scripts." ;
    prov:wasDerivedFrom spec:source-e9e453bf ;
    specl:sourceLine "132"^^xsd:integer ;
    specl:implementationStatus "implemented" ;
    specl:priority "MUST" ;
    specl:constrains spec:component-pyproject ;
    specl:acceptanceCriterion "After pip install, specl-translate, specl-validate, and specl-assist are on PATH and --help works." .

spec:R6.2 a specl:Requirement ;
    specl:partOf <https://w3id.org/specl/tool/spec> ;
    dct:title "shapes.ttl, core.ttl, and explorer.html must be included as package data" ;
    dct:description "shapes.ttl, core.ttl, and explorer.html must be included as package data." ;
    prov:wasDerivedFrom spec:source-e9e453bf ;
    specl:sourceLine "137"^^xsd:integer ;
    specl:implementationStatus "verified" ;
    specl:verifiedBy spec:test-f20a4e93 ;
    specl:priority "MUST" ;
    specl:constrains spec:component-pyproject ;
    specl:acceptanceCriterion "After pip install, importlib.resources.files('specl').joinpath('shapes.ttl') resolves." .

spec:US1 a specl:UserStory ;
    specl:partOf <https://w3id.org/specl/tool/spec> ;
    dct:title "As a spec author, I run specl-translate on my markdown, specl-validate to check…" ;
    dct:description "As a spec author, I run specl-translate on my markdown, specl-validate to check it, and see a maturity score that climbs as I add annotations." ;
    prov:wasDerivedFrom spec:source-e9e453bf ;
    specl:sourceLine "161"^^xsd:integer ;
    specl:role spec:P1 ;
    specl:capability "translate, validate, and see a maturity score" ;
    specl:benefit "the specification's completeness is visible rather than guessed at" ;
    specl:acceptanceCriterion "Given a markdown specification when translated and validated then a maturity score is reported" .

spec:US2 a specl:UserStory ;
    specl:partOf <https://w3id.org/specl/tool/spec> ;
    dct:title "As a CI pipeline, I run specl-validate on every PR and fail the build if a…" ;
    dct:description "As a CI pipeline, I run specl-validate on every PR and fail the build if a production-status spec has violations or warnings." ;
    prov:wasDerivedFrom spec:source-e9e453bf ;
    specl:sourceLine "166"^^xsd:integer ;
    specl:role spec:P2 ;
    specl:capability "fail a build when a production specification carries warnings" ;
    specl:benefit "a specification cannot regress silently once it claims to be production ready" ;
    specl:acceptanceCriterion "Given a production-status specification with warnings when validated then the command exits non-zero" .

spec:US3 a specl:UserStory ;
    specl:partOf <https://w3id.org/specl/tool/spec> ;
    dct:title "As an AI agent, I read the translated spec.ttl to understand what a system…" ;
    dct:description "As an AI agent, I read the translated spec.ttl to understand what a system should do before generating code." ;
    prov:wasDerivedFrom spec:source-e9e453bf ;
    specl:sourceLine "171"^^xsd:integer ;
    specl:role spec:P3 ;
    specl:capability "read the translated graph before writing code" ;
    specl:benefit "the specification rather than a summary of it is what the code is written against" ;
    specl:acceptanceCriterion "Given a translated specification when queried for its requirements then each returns its acceptance criteria" .

spec:OQ1 a specl:OpenIssue ;
    specl:partOf <https://w3id.org/specl/tool/spec> ;
    dct:title "Whether to add a scaffolding command that creates a new spec directory with a…" ;
    dct:description "Whether to add a scaffolding command that creates a new spec directory with a template spec.md. Its CLI surface is undecided and follows `docs/decisions/0001-cli-surface.md`; there is no umbrella `specl` command to hang it on." ;
    prov:wasDerivedFrom spec:source-e9e453bf ;
    specl:sourceLine "179"^^xsd:integer ;
    specl:owner spec:AG1 ;
    specl:recommendation "Deferred. It was recommended for 0.4.0 and nine releases passed without it being wanted, which is evidence that it is not needed. `docs/SYNTAX.md` shows the front matter and copying an existing specification is the path people actually take. From 1.0 adding a command is additive and ungoverned, so it can arrive whenever someone asks" ;
    specl:resolutionStatus "deferred" .

spec:OQ2 a specl:OpenIssue ;
    specl:partOf <https://w3id.org/specl/tool/spec> ;
    dct:title "Whether specl-validate should default to the bundled shapes.ttl via…" ;
    dct:description "Whether specl-validate should default to the bundled shapes.ttl via importlib.resources when no shapes path is given." ;
    prov:wasDerivedFrom spec:source-e9e453bf ;
    specl:sourceLine "183"^^xsd:integer ;
    specl:owner spec:AG1 ;
    specl:recommendation "Implemented. It was the first command an adopter runs and it failed, because nothing tells someone who pip installed the package where the bundled file lives" ;
    specl:resolutionStatus "resolved" .

spec:OQ3 a specl:OpenIssue ;
    specl:partOf <https://w3id.org/specl/tool/spec> ;
    dct:title "Whether to support a `namespace_style: hash | slash` front-matter key for specs…" ;
    dct:description "Whether to support a `namespace_style: hash | slash` front-matter key for specs that want per-element slash URIs (Schema.org pattern)." ;
    prov:wasDerivedFrom spec:source-e9e453bf ;
    specl:sourceLine "187"^^xsd:integer ;
    specl:owner spec:AG1 ;
    specl:recommendation "Declined. Hash namespaces are what every emitted graph and both published contracts use, and a per-specification choice would make two specifications with the same items produce different IRIs. That is a contract-level change and would need the 2.0 window, not a front-matter key" ;
    specl:resolutionStatus "resolved" .

spec:P1 a specl:Persona ;
    specl:partOf <https://w3id.org/specl/tool/spec> ;
    dct:title "Someone writing a specification in markdown and wanting to know whether it is…" ;
    dct:description "Someone writing a specification in markdown and wanting to know whether it is complete." ;
    prov:wasDerivedFrom spec:source-e9e453bf ;
    specl:sourceLine "151"^^xsd:integer ;
    skos:prefLabel "Spec author" .

spec:P2 a specl:Persona ;
    specl:partOf <https://w3id.org/specl/tool/spec> ;
    dct:title "A continuous integration pipeline validating a specification on every change" ;
    dct:description "A continuous integration pipeline validating a specification on every change." ;
    prov:wasDerivedFrom spec:source-e9e453bf ;
    specl:sourceLine "153"^^xsd:integer ;
    skos:prefLabel "CI pipeline" .

spec:P3 a specl:Persona ;
    specl:partOf <https://w3id.org/specl/tool/spec> ;
    dct:title "A coding agent reading a translated specification before writing code against it" ;
    dct:description "A coding agent reading a translated specification before writing code against it." ;
    prov:wasDerivedFrom spec:source-e9e453bf ;
    specl:sourceLine "155"^^xsd:integer ;
    skos:prefLabel "AI agent" ;
    skos:altLabel "coding agent" .

spec:AG1 a specl:Agent ;
    specl:partOf <https://w3id.org/specl/tool/spec> ;
    dct:title "The maintainer accountable for specl's specification and releases" ;
    dct:description "The maintainer accountable for specl's specification and releases." ;
    prov:wasDerivedFrom spec:source-e9e453bf ;
    specl:sourceLine "146"^^xsd:integer ;
    skos:prefLabel "Maintainer" .

