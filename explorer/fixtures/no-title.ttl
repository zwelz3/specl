# HAND-AUTHORED FIXTURE. Not translator output and must not be regenerated.
# Condition under test: R4.2, an item carrying no dct:title
@prefix specl: <https://w3id.org/specl/ns#> .
@prefix spec: <https://w3id.org/specl/fixtures/no-title#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://w3id.org/specl/fixtures/no-title> a specl:Specification ;
    dct:conformsTo <https://w3id.org/specl/contract/2> ;
    dct:title "Fixture no-title" ;
    dct:hasVersion "0.0.1" ;
    specl:status "draft" ;
    specl:intent """Hand-authored fixture.""" ;
    specl:purpose """Stage 0.""" .

spec:R1 a specl:Requirement ;
    specl:partOf <https://w3id.org/specl/fixtures/no-title> ;
    dct:description "This requirement has a description and no title, so the row falls back to a preview." .
